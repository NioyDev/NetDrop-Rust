# ==========================================
# NetDrop - .gitignore
# ==========================================

# --- Cargo & Rust Builds ---
target/
debug/
*.rs.bk
*.pdb
rustc-ice-*.txt
**/mutants.out*/

# --- Distribution & Binaries ---
dist/
*.exe
*.zip
*.tar.gz
*.deb
*.apk
*.idsig

# --- Android Build & Gradle Artifacts ---
.gradle/
android/.gradle/
android/build/
android/app/build/
android/build_temp/
build_temp/
local.properties
*.keystore
*.jks
*.dex
*.class
gen/

# --- Dynamic Uploads & Runtime Directories ---
static/Files/*
!static/Files/.gitkeep
static/qr/*
!static/qr/.gitkeep
File/
QR/
data/

# --- IDEs & Editors ---
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# --- OS Artifacts ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# --- Python & Test Artifacts ---
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
